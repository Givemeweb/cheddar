# Supabase (required for subscription features)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IAP SKU Configuration
EXPO_PUBLIC_IAP_MONTHLY_SKU=cheddar_premium_monthly
EXPO_PUBLIC_IAP_ANNUAL_SKU=cheddar_premium_annual

# Umami Analytics (optional)
EXPO_PUBLIC_UMAMI_ENDPOINT=https://your-umami-instance.com
EXPO_PUBLIC_UMAMI_WEBSITE_ID=your-website-id
