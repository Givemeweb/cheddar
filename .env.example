# Voice-to-Transaction API Configuration
# Set this to your backend extraction endpoint base URL
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# SatSale purchase API served by the same PocketBase instance.
EXPO_PUBLIC_SATSALE_API_URL=http://localhost:3000/api/satsale

# Debug SatSale builds use this URL when it is set. It must be https:// except
# for a localhost development server. Release builds ignore it, so the
# production URL above can stay in place. Put the staging URL in .env.local
# (ignored) or export it for the command. See docs/staging-testnet.md.
EXPO_PUBLIC_SATSALE_STAGING_API_URL=

# RevenueCat public SDK keys (RevenueCat dashboard > Projects > API keys)
# iOS uses the Apple App Store key, Android uses the Google Play Store key.
EXPO_PUBLIC_RC_API_KEY_IOS=
EXPO_PUBLIC_RC_API_KEY_ANDROID=
