{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@payment-provider": [
        "./src/payments/selectPaymentProvider.ts"
      ],
      "@crypto-payment": [
        "./src/payments/cryptoDisabled.tsx"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
